# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEURO_API_KEY=replace-with-a-random-private-key
NEURO_ENABLE_INFERENCE=false
NEURO_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","https://neurosim.ronsys11.chatgpt.site"]
NEURO_DATA_DIR=./jobs
NEURO_CACHE_DIR=./cache
NEURO_MODEL_ID=facebook/tribev2
NEURO_MODEL_REVISION=main
NEURO_DEVICE=cuda
NEURO_RETENTION_HOURS=24
# Set HF_TOKEN in the process environment or GPU provider's secrets, not here.
